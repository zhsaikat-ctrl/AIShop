# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/aishop

# Auth
JWT_SECRET=example_secret

# AI / OpenAI
OPENAI_API_KEY=example_openai_key

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=example_cloud_name
CLOUDINARY_API_KEY=example_cloud_key
CLOUDINARY_API_SECRET=example_cloud_secret
CLOUDINARY_UPLOAD_PRESET=example_preset

# OTP Email (Gmail App Password)
OTP_EMAIL_USER=example@gmail.com
OTP_EMAIL_PASS=example_app_password

# Stripe Payment
STRIPE_SECRET_KEY=example_stripe_secret

# SSLCommerz Payment
SSLC_STORE_ID=example_store_id
SSLC_STORE_PASS=example_store_pass
SSLC_IS_LIVE=false
