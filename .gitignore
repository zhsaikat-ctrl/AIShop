# =========================
# ENV (সিক্রেট ফাইল)
# =========================
**/.env
**/.env.*
!**/.env.example

# =========================
# Node / Frontend / Backend
# =========================
**/node_modules/
**/dist/
**/build/
**/.vite/
**/coverage/
**/.cache/
**/*.tsbuildinfo

# logs
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# Python / Django
# =========================
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/

# Django static (only if generated)
**/staticfiles/

# =========================
# Local DB / runtime files
# =========================
**/db.sqlite3

# uploads/media (যদি লোকালে থাকে)
**/media/

# =========================
